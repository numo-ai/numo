{
  "name": "numo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tabler/icons-react": "^3.46.0",
      "@tailwindcss/postcss": "^4",
      "@types/bun": "^1.4.2",
      "@types/node": "^22.20.2",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "better-auth": "^1.7.4",
      "dotenv": "^17.4.2",
      "next-themes": "^0.4.6",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "resend": "^6.27.0",
      "sonner": "^2.0.8",
      "tailwind-variants": "^3.3.1",
      "tailwindcss": "^4",
      "typescript": "7.0.2",
      "zod": "^4.6.1",
      "motion": "^13.2.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "dev:api": "turbo run dev -F @numo/api --",
    "dev:web": "turbo run dev -F @numo/web --",
    "db:push": "turbo run db:push -F @numo/db --",
    "db:generate": "turbo run db:generate -F @numo/db --",
    "db:migrate": "turbo run db:migrate -F @numo/db --",
    "db:reset": "turbo run db:reset -F @numo/db --"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@numo/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
